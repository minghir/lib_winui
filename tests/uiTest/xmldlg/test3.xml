						name="editAdresa" 
						type="vEdit" 
						widthMode="FIXED" 
						heightMode="FIXED" 
						anchor="RIGHT-MIDDLE" 
						x="100" y="0" 
						width="100" height="25"
						gridRow="0" gridColumn="0"  
						marginLeft="0" marginTop="0" marginRight="0" marginBottom="0" 
						background="#ffffff"
						textColor="#000000"
						font="test2">
						<default_text>Adresa</default_text>
						<!-- <handler name="lost_focus" function="onMimi"/> -->
						<validation pattern="^[A-Za-z]+$" error="Adresa trebuie sa contina doar litere!"/>
						<handler name="lost_focus" function="validateAdress" />
					</vControl>
					
