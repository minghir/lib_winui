									<text>Alege metoda:</text>
									<vControl name="opt1" type="vRadioButton" x="10" y="30" width="100" height="20" font="test3">
										<text>Card Bancar</text>
									</vControl>
									<vControl name="opt2" type="vRadioButton" selected="true" x="10" y="50" width="100" height="20" font="test3">
										<text>Cash</text>
									</vControl>
									<vControl name="opt3" type="vRadioButton" x="10" y="70" width="100" height="20" font="test3">
										<text>Acord</text>
									</vControl>
									<vControl name="opt4" type="vRadioButton" x="10" y="90" width="100" height="20" font="test3">
										<text>Exclus</text>
									</vControl>
							</vContainer>
					</vContainer>
					
			</vContainer>
