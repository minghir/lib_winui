						width="100" height="25"
						gridRow="0" gridColumn="0"  
						marginLeft="0" marginTop="0" marginRight="0" marginBottom="0" 
						textAlign="RIGHT-BOTTOM"
						background="#7F518C"
						font="test2">
						<text>Adresa:</text>
					</vControl>
