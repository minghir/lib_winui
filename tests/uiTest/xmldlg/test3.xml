<vXmlDialog name="dialogUtilizatori" title="Editare utilizatori" WindowType="DialogWindow" LayoutStrategy="VerticalStackLayout" x="100" y="100" width="1024" height="768" minWidth="600" minHeight="400"  background="#ADC7C9" font="test1" >
