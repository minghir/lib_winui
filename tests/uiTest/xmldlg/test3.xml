					<vControl 
						name="buttonOK" 
						type="vButton" 
						widthMode="FIXED" 
						heightMode="FIXED" 
						anchor="LEFT-BOTTOM" 
						x="100" y="10" 
						width="45" height="25"
						gridRow="0" gridColumn="0"  
						marginLeft="0" marginTop="0" marginRight="0" marginBottom="0" 
						background="#ffffff"
						textColor="#6A7012"
						font="test3">
						<text>&OK</text>
						<handler name="click" function="onOK"/>
					</vControl>
					<vControl 
						name="buttonCancel" 
						type="vButton" 
						widthMode="FIXED" 
						heightMode="FIXED" 
						anchor="RIGHT-BOTTOM" 
						x="150" y="10" 
						width="75" height="25"
						gridRow="0" gridColumn="0"  
						marginLeft="0" marginTop="0" marginRight="0" marginBottom="0" 
						background="#6A7012"
						textColor="#E3122C"
						font="test2">
						<text>&Cancel</text>
						<handler name="click" function="onCancel"/>
					</vControl>
					<vControl 
						name="buttonTest" 
						type="vButton" 
						widthMode="FIXED" 
						heightMode="FIXED" 
						anchor="RIGHT-BOTTOM" 
						x="250" y="10" 
						width="75" height="25"
						gridRow="0" gridColumn="0"  
						marginLeft="0" marginTop="0" marginRight="0" marginBottom="0" 
						background="#6A7012"
						textColor="#E3122C"
						font="test2">
						<text>&Test</text>
						<handler name="click" function="onTest"/>
					</vControl>
					<vControl 
						name="editDataTT" 
						type="vDbGridPicker" 
						widthMode="FIXED" 
						heightMode="FIXED" 
						anchor="RIGHT-MIDDLE" 
						x="460" y="35" 
						width="200" height="25"
						gridRow="0" gridColumn="0"  
						marginLeft="10" marginTop="10" marginRight="10" marginBottom="10" 
						background="#999999"
						textColor="#00FF00"
						font="test3"
						>
						<attribute name="targetQuery" value="select registration from date_aviatie.fleet" />
						<attribute name="returnColumn" value="registration" />
						<text>MIMI</text>
					</vControl>
			</vContainer>
