				<text>Nume prenume:</text>
			</vControl>
			<vControl 
				name="editNumePrenume" 
				type="vEdit" 
				widthMode="FIXED" 
				heightMode="FIXED" 
				anchor="LEFT-CENTER_H"
				x="824" y="0" 
				width="200" height="25"
				gridRow="0" gridColumn="0"  
				marginLeft="0" marginTop="0" marginRight="0" marginBottom="0" 
				background="#ffffff"
				enabled="false"
				font="test2">
				<default_text>Nume prenume default</default_text>
				<attribute name="readOnly" value="true" /> 
			
			</vControl>
			
			
